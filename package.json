{
  "name": "demogame",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite",
    "build": "pnpm typecheck && electron-vite build",
    "build:web": "pnpm typecheck && vite build",
    "preview": "electron-vite preview",
    "dist": "pnpm build && electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "electron-vite build && playwright test",
    "lint:deps": "depcruise src electron tools --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint:deps && pnpm test && pnpm check:design",
    "sim": "tsx tools/sim.ts",
    "tokens": "tsx scripts/build-tokens.ts",
    "check:design": "tsx scripts/check-literals.ts",
    "check:assets": "tsx scripts/check-assets.ts",
    "visual": "tsx tools/visual/compare.ts"
  },
  "devDependencies": {
    "@esotericsoftware/spine-phaser-v4": "^4.2.120",
    "@playwright/test": "^1.64.1",
    "@swc/core": "^1.16.20",
    "@types/node": "^26.6.5",
    "dependency-cruiser": "^18.7.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "phaser": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.16.1"
}
